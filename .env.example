# --- App ---
# Public URL of the portal (used in QR codes, emails, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Shopify ---
# Webhook signing secret from Shopify Admin > Settings > Notifications > Webhooks
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret
# Storefront domain, used for upsell links (e.g. utee-shop.myshopify.com or myutee.com)
NEXT_PUBLIC_SHOPIFY_STORE_URL=https://myutee.com
# SKUs / product title keywords that identify a UTI test kit line item (comma separated)
TEST_KIT_SKUS=UTEE-TEST-KIT

# --- Recharge (subscriptions) ---
RECHARGE_API_TOKEN=your-recharge-api-token
# Webhook client secret (Recharge admin > API tokens > webhooks). Different
# from the access token above; /api/webhooks/recharge rejects unsigned posts.
RECHARGE_WEBHOOK_SECRET=your-recharge-webhook-secret

# --- Resend (transactional email) ---
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Utee <care@myutee.com>"
# Internal notification recipients
LAB_NOTIFICATION_EMAIL=lab@example.com
CLINIC_NOTIFICATION_EMAIL=clinic@example.com
ADMIN_NOTIFICATION_EMAIL=admin@myutee.com

# --- Parcel tracking ---
# "mock" for local dev (admins advance parcels by hand on the kit page),
# "trackship" to register every tracking number with TrackShip at dispatch and
# receive its status webhooks at /api/webhooks/trackship, or "webhook" when a
# carrier/aggregator posts the generic shape to /api/webhooks/tracking.
TRACKING_PROVIDER=mock
# Shared secret: X-Tracking-Secret header on /api/webhooks/tracking, or
# ?secret= on the TrackShip webhook URL.
TRACKING_WEBHOOK_SECRET=change-me
# TrackShip (trackship.com): API key and the app-name header it requires.
TRACKSHIP_API_KEY=
TRACKSHIP_APP_NAME="Utee Portal"
# Resend delivery webhook signing secret (Resend dashboard > Webhooks, "whsec_...")
# so email_log shows delivered / bounced after sending.
RESEND_WEBHOOK_SECRET=

# --- UTI tracker ---
# Link to the Utee community (leave empty to hide the card)
NEXT_PUBLIC_COMMUNITY_URL=
# Bearer token Vercel Cron sends to /api/cron/tracker-reminders (any long random string)
CRON_SECRET=change-me

# Optional. Lets the tracker's guided setup read typed answers into form fields
# (Anthropic API). Without it the guided setup uses simple phrase matching.
ANTHROPIC_API_KEY=
