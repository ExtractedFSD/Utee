# --- App ---
# Public URL of the portal (used in QR codes, emails, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Shopify ---
# Webhook signing secret from Shopify Admin > Settings > Notifications > Webhooks
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret
# Storefront domain, used for upsell links (e.g. utee-shop.myshopify.com or www.utee.co.uk)
NEXT_PUBLIC_SHOPIFY_STORE_URL=https://www.utee.co.uk
# SKUs / product title keywords that identify a UTI test kit line item (comma separated)
TEST_KIT_SKUS=UTEE-TEST-KIT

# --- Recharge (subscriptions) ---
RECHARGE_API_TOKEN=your-recharge-api-token
# Webhook client secret (Recharge admin > API tokens > webhooks). Different
# from the access token above; /api/webhooks/recharge rejects unsigned posts.
RECHARGE_WEBHOOK_SECRET=your-recharge-webhook-secret

# --- Resend (transactional email) ---
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Utee <care@utee.co.uk>"
# Internal notification recipients
LAB_NOTIFICATION_EMAIL=lab@example.com
CLINIC_NOTIFICATION_EMAIL=clinic@example.com
ADMIN_NOTIFICATION_EMAIL=admin@utee.co.uk

# --- Parcel tracking ---
# "mock" for local dev, "webhook" when a carrier/aggregator (Royal Mail via
# AfterShip or Royal Mail Tracking API push) posts events to /api/webhooks/tracking
TRACKING_PROVIDER=mock
# Shared secret the tracking webhook must present in the X-Tracking-Secret header
TRACKING_WEBHOOK_SECRET=change-me
