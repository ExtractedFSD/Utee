{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/holders/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cooper|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Cooper, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|href|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, onClick, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CircleImageHolder'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|label|size|style|key|ref|className|style|children)$/]",
        "message": "<CircleImageHolder> doesn't accept that prop. Declared props: src, alt, label, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurveImageHolder'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|width|height|style|key|ref|className|style|children)$/]",
        "message": "<CurveImageHolder> doesn't accept that prop. Declared props: src, alt, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EyebrowTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|pill|onDark|style|key|ref|className|style|children)$/]",
        "message": "<EyebrowTab> doesn't accept that prop. Declared props: children, pill, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|role|style|key|ref|className|style|children)$/]",
        "message": "<QuoteCard> doesn't accept that prop. Declared props: quote, name, role, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:range|children|style|key|ref|className|style|children)$/]",
        "message": "<RangeTag> doesn't accept that prop. Declared props: range, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeTag'] > JSXAttribute[name.name='range'] > Literal[value!=/^(?:mint|peach|sky|sun|lavender)$/]",
        "message": "<RangeTag> range must be one of 'mint' | 'peach' | 'sky' | 'sun' | 'lavender'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoundHoldingDevice'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|style|key|ref|className|style|children)$/]",
        "message": "<RoundHoldingDevice> doesn't accept that prop. Declared props: children, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Sticker> doesn't accept that prop. Declared props: children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "Card": {
        "replaces": []
      },
      "CircleImageHolder": {
        "replaces": []
